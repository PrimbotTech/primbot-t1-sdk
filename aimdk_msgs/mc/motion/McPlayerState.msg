# -----------------------------------------------------------------------------------
# 机器人运控状态 - 上肢动作运行状态
# -----------------------------------------------------------------------------------

uint32 value

# 无上肢动作
uint32 IDLE = 0

# IDLE 过渡至下一动作
uint32 PRE_PLAYING = 1

# 上肢动作正在播放
uint32 PLAYING = 2

# 打断当前动作过渡至下一动作
uint32 INTERRUPTING = 3

# 播放错误状态
uint32 ERROR = 4
