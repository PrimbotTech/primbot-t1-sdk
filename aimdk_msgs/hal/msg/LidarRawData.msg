# --------------------------------------------------------------------------------------------------------------
# 机器人激光雷达原始数据 (Raw packets from LiDAR sensor)
# --------------------------------------------------------------------------------------------------------------
# 头部信息：时间戳、坐标系、序列号等
MessageHeader header

# MSOP (Measurement Data Packets):
#   - 含点云量测数据原始字节
#   - 通常为设备按固定包长度输出的连续数据
#   - 不做解析，保持原始二进制序列
uint8[] msop_data

# DIFOP (Device Information Packets):
#   - 设备状态、校准、雷达内部配置等信息
#   - 一般频率低于 MSOP
#   - 解析可用于标定/雷达健康监测
uint8[] difop_data
