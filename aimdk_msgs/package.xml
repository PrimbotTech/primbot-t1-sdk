<?xml version="1.0"?>
<package format="3">
  <name>aimdk_msgs</name>
  <version>1.0.0</version>
  <description>
    启元机器人二次开发 SDK。
    提供核心运行相关：ROS2 Service/Message 接口定义，
    涵盖硬件抽象、运控及人机交互控制层级（mc / hal / interaction）。
  </description>
  <maintainer email="sdk@primebot.com">Primebot Team</maintainer>
  <license>Apache License 2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>rosidl_default_generators</buildtool_depend>

  <!-- 消息依赖 -->
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>builtin_interfaces</depend>

  <!-- Python 运行时 -->
  <exec_depend>python3-rclpy</exec_depend>
  <exec_depend>rmw_fastrtps_cpp</exec_depend>
  <exec_depend>rosidl_default_runtime</exec_depend>
  <member_of_group>rosidl_interface_packages</member_of_group>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
