if [ -z "$RMW_IMPLEMENTATION" ]; then
  export RMW_IMPLEMENTATION=rmw_fastrtps_cpp
fi

_aimdk_fastdds_profiles="$AMENT_CURRENT_PREFIX/share/aimdk_msgs/config/fastdds_profiles.xml"

if [ -f "$_aimdk_fastdds_profiles" ]; then
  if [ -z "$FASTRTPS_DEFAULT_PROFILES_FILE" ] && [ -z "$FASTDDS_DEFAULT_PROFILES_FILE" ]; then
    export FASTRTPS_DEFAULT_PROFILES_FILE="$_aimdk_fastdds_profiles"
    export FASTDDS_DEFAULT_PROFILES_FILE="$_aimdk_fastdds_profiles"
  elif [ -n "$FASTRTPS_DEFAULT_PROFILES_FILE" ] && [ -z "$FASTDDS_DEFAULT_PROFILES_FILE" ]; then
    export FASTDDS_DEFAULT_PROFILES_FILE="$FASTRTPS_DEFAULT_PROFILES_FILE"
  elif [ -z "$FASTRTPS_DEFAULT_PROFILES_FILE" ] && [ -n "$FASTDDS_DEFAULT_PROFILES_FILE" ]; then
    export FASTRTPS_DEFAULT_PROFILES_FILE="$FASTDDS_DEFAULT_PROFILES_FILE"
  fi
fi

unset _aimdk_fastdds_profiles
